[include]
	path = ~/.gitconfig.local

[credential]
        helper = /mnt/c/Program\\ Files/Git\\ Credential\\ Manager/git-credential-manager.exe

[credential "https://dev.azure.com"]
        useHttpPath = true

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = true
